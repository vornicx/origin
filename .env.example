# ══════════════════════════════════════════════════════════════
# Origin Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env — it's in .gitignore.
# ══════════════════════════════════════════════════════════════

# LLM API Keys
DEFAULT_LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENCODE_API_KEY=your_opencode_api_key_here
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434

# Database
DATABASE_URL=postgresql://postgres:password@localhost/origin_db

# Fish Audio TTS (voice cloning)
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# ElevenLabs TTS (premium, multilingual, high quality)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Telegram Bot (remote access)
# 1. Create bot via @BotFather, paste token here
# 2. Send /start to your bot, chat_id auto-registers (or set manually)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=

# Spotify (optional)
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIPY_REDIRECT_URI=http://localhost:8888/callback

# Email SMTP (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Environment
DEBUG=false
LOG_LEVEL=INFO
# Set to "json" in production for structured logging (parseable by log aggregators)
LOG_FORMAT=text

# Security
# Required in production — random HMAC secret for auth tokens (run: python -c "import secrets; print(secrets.token_hex(32))")
ORIGIN_JWT_SECRET=

# Set to 1 only in dev to auto-create admin/origin default user
ORIGIN_ALLOW_DEFAULT_ADMIN=0

# Caching — leave empty for in-process TTL dict (fine for single-machine desktop mode)
# Set to redis://localhost:6379 to enable Redis caching
REDIS_URL=

# ══════════════════════════════════════════════════════════════
# Crucix Intelligence Engine (crucix/)
# 27 OSINT sources, Jarvis dashboard on port 3117
# ══════════════════════════════════════════════════════════════

# Crucix server port
CRUCIX_PORT=3117
# Auto-refresh interval (minutes)
CRUCIX_REFRESH_INTERVAL=15

# OSINT Source API Keys (all free, optional)
FRED_API_KEY=
FIRMS_MAP_KEY=
EIA_API_KEY=
AISSTREAM_API_KEY=
ACLED_EMAIL=
ACLED_PASSWORD=
CLOUDFLARE_API_TOKEN=

# Crucix LLM Layer (optional, for AI-enhanced trade ideas)
# Provider: anthropic | openai | gemini | codex | openrouter | minimax | mistral | ollama | grok
CRUCIX_LLM_PROVIDER=
CRUCIX_LLM_API_KEY=
CRUCIX_LLM_MODEL=

# Crucix Telegram Alerts (optional)
CRUCIX_TELEGRAM_BOT_TOKEN=
CRUCIX_TELEGRAM_CHAT_ID=

# Crucix Discord Alerts (optional)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=

# ══════════════════════════════════════════════════════════════
# Osiris OSINT Dashboard (osiris/)
# MapLibre GL intelligence platform on port 3000
# ══════════════════════════════════════════════════════════════

# Osiris server port
OSIRIS_PORT=3000

# RECON Scanner Backend (optional, for port/DNS/WHOIS/vuln scanning)
SCANNER_URL=
SCANNER_KEY=

# Optional data source keys (higher rate limits)
FIRMS_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
N2YO_API_KEY=
AIS_API_KEY=
